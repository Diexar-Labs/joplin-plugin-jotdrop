{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"allowJs": false,
		"baseUrl": ".",
		"paths": { "api": ["./api"], "api/*": ["./api/*"] }
	},
	"include": ["src/**/*.ts", "api/**/*.ts"]
}
